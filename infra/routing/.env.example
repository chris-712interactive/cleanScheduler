# Public name that points at this VPS. Caddy requests a certificate for it.
ROUTING_DOMAIN=routing.example.com

# Let's Encrypt account email.
ACME_EMAIL=you@example.com

# Shared secret. Generate with: openssl rand -hex 32
# The app sends this as: Authorization: Bearer <token>
ROUTING_ENGINE_TOKEN=replace-with-openssl-rand-hex-32

# Geofabrik extract. North Carolina is the sample. See README.md to change it.
TILE_URLS=https://download.geofabrik.de/north-america/us/north-carolina-latest.osm.pbf

# Set True for one boot when refreshing map data, then set it back to False.
FORCE_REBUILD=False
